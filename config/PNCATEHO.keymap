#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";
            bindings = <
&kp M  &kp B  &kp E  &kp LC(EQUAL)
&kp S  &kp H  &kp I  &kp LC(MINUS)
                     &kp LC(Z)  &kp LC(LS(Z))
            >;
        };

        lower_layer {
            label = "lower";
            bindings = <
&none  &none  &none  &none
&none  &none  &none  &none
                     &trans  &mo 3
            >;
        };

        raise_layer {
            label = "raise";
            bindings = <
&none  &none  &none  &none
&none  &none  &none  &none
                     &mo 3  &trans
            >;
        };

        adjust_layer {
            label = "adjust";
            bindings = <
&bootloader  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &none
&bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2
                                               &none         &none
            >;
        };
    };
};
