#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    behaviors {
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = 
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp PLUS>,
                <&macro_release &kp LCTRL>;
        };

        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = 
                <&macro_press &kp LCTRL>,
                <&macro_tap &kp MINUS>,
                <&macro_release &kp LCTRL>;
        };

        undo: undo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = 
                <&macro_press &kp LCTRL>, 
                <&macro_tap &kp Z>,
                <&macro_release &kp LCTRL>;
        };

        redo: redo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = 
                <&macro_press &kp LCTRL &kp LSHFT>, 
                <&macro_tap &kp Z>, 
                <&macro_release &kp LCTRL &kp LSHFT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "default";
            bindings = <
&kp M  &kp B  &kp E  &zoom_out
&kp S  &kp H  &kp I  &zoom_in
                     &undo  &redo
            >;
        };

        lower_layer {
            label = "lower";
            bindings = <
&none  &none  &none  &none
&none  &none  &none  &none
                     &trans  &mo 3
            >;
        };

        raise_layer {
            label = "raise";
            bindings = <
&none  &none  &none  &none
&none  &none  &none  &none
                     &mo 3  &trans
            >;
        };

        adjust_layer {
            label = "adjust";
            bindings = <
&bootloader  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &none
&bt BT_CLR   &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2
                                               &none         &none
            >;
        };
    };
};
